# Server (API default port 3001 — Swagger UI: http://localhost:3001/api/docs)
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=opencurtain_db
DB_LOGGING=false

# Auth (required — use a long random string; never commit real secrets)
JWT_SECRET=
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
EMAIL_VERIFICATION_EXPIRES_IN=24h
PASSWORD_RESET_EXPIRES_IN=1h
APP_PUBLIC_URL=http://localhost:3000
BCRYPT_SALT_ROUNDS=10
