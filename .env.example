PORT=3001
NODE_ENV=development
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=opencurtain_db
DB_SSL=false
DB_LOGGING=false

JWT_SECRET=
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
EMAIL_VERIFICATION_EXPIRES_IN=24h
PASSWORD_RESET_EXPIRES_IN=1h
APP_PUBLIC_URL=http://localhost:3000
BCRYPT_SALT_ROUNDS=10
SEED_DEV_PASSWORD=

# Email (optional — logs to console in development when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@opencurtain.com
EMAIL_FROM_NAME=OpenCurtain
CONTACT_INBOX=hello@opencurtain.com

# File uploads (stored in S3; deleted after admin review for verifications)
UPLOAD_MAX_FILE_SIZE=10485760
AWS_REGION=us-east-1
AWS_S3_BUCKET=opencurtain-dev
# Optional root prefix inside the bucket, e.g. dev or staging
AWS_S3_KEY_PREFIX=
# Local dev only — EC2 uses its instance IAM role instead
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- EC2 + RDS (Vercel frontend: https://open-curtain-web.vercel.app) ---
# NODE_ENV=production
# HOST=0.0.0.0
# CORS_ORIGIN=https://open-curtain-web.vercel.app
# APP_PUBLIC_URL=https://open-curtain-web.vercel.app
# DB_HOST=your-db.xxxxx.region.rds.amazonaws.com
# DB_SSL=true
